{
  "name": "lidar",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:test": "node build.mjs --test",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build:test && playwright test",
    "icons": "node scripts/make-icons.mjs",
    "package": "npm run build && rm -f lidar.zip && cd dist && zip -qr ../lidar.zip .",
    "store": "npm run build:test && node store/shoot.mjs",
    "demo": "npm run build:test && node store/record.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
