// The site/ Worker. It's static: wrangler serves the Astro build in dist/ as assets, with no Worker code.
// .github/workflows/site.yml deploys it. (Without this file, `wrangler deploy` sets the project up itself and
// converts it to server rendering.)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lidar",
  "account_id": "1148754027b663d3dde616e59d274aa8",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist"
  }
}
