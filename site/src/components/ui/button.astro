---
interface Props { href: string; ghost?: boolean; class?: string; style?: string }
const { href, ghost = false, class: cls, style } = Astro.props;
const external = /^https?:/.test(href);
---
<a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined} style={style} data-measure="pill" class:list={['btn', ghost ? 'btn-ghost' : 'btn-primary', cls]}>
  <span class="btn-label"><slot />{external && <span class="sr-only"> (opens in a new tab)</span>}</span>
  <span class="btn-end">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg>
  </span>
</a>
