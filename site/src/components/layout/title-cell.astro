---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> { as?: 'a' | 'span' | 'p' }
const { as: Tag = 'span', class: cls, ...rest } = Astro.props;
const external = /^https?:/.test(String(rest.href ?? ''));
---
<Tag class:list={['flex min-h-13 items-center border-r border-line px-6 py-4 no-underline last:border-r-0 max-md:px-4', cls]} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined} {...rest}><slot />{external && <span class="sr-only"> (opens in a new tab)</span>}</Tag>
