---
import Row from '../Row.astro';
import Note from '../Note.astro';
import Rise from '../Rise.astro';

const notIncluded = ['Accounts', 'Paywalls', 'Analytics', 'Tracking'];
---
<Row band class="flex flex-col gap-7 px-6 py-16">
  <Note class="fade text-on-acc">background: var(--color-acc) · price: $0.00 · forever</Note>
  <h2 class="big text-[clamp(40px,9.5vw,128px)] tracking-[-.03em]">
    <Rise>Every feature.</Rise>
    <Rise i={1}>Zero dollars.</Rise>
  </h2>
  <div class="flex flex-wrap items-end justify-between gap-10 border-t border-on-acc/25 pt-7">
    <blockquote class="fade flex max-w-160 flex-col gap-3.5" style="--i:3">
      <p class="text-[clamp(22px,2.4vw,30px)] leading-[1.3] font-semibold">“I got sick of being forced to pay for tools developers shouldn’t have to pay for. So I made my own.”</p>
      <footer class="font-mono text-[13px] leading-none font-medium tracking-[.06em] uppercase">— Vlad Anisov, who made Lidar</footer>
    </blockquote>
    <div class="fade" style="--i:4">
      <p class="sr-only">Not included:</p>
      <ul class="flex flex-wrap font-mono text-[13px] leading-none font-semibold tracking-[.06em] uppercase">
        {notIncluded.map((item, i) => <li class="strike px-3.5 py-3 shadow-[inset_0_0_0_1px_var(--color-on-acc)]" style={`--i:${i}`}>{item}</li>)}
      </ul>
    </div>
  </div>
</Row>
