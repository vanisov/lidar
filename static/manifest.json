{
  "manifest_version": 3,
  "name": "Lidar: Measure & Inspect the Web",
  "short_name": "Lidar",
  "version": "1.0.0",
  "description": "Precision inspection for the web. Measure spacing, inspect CSS, pick colors, and copy elements for AI. Free, forever.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Lidar", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+L" }, "description": "Toggle Lidar" }
  }
}
